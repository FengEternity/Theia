# LLM provider configuration (used by LiteLLM)
# Uncomment the provider you want to use:

# OpenAI
# OPENAI_API_KEY=sk-...

# Anthropic
# ANTHROPIC_API_KEY=sk-ant-...

# DeepSeek
# DEEPSEEK_API_KEY=...

# Local (Ollama)
# OLLAMA_API_BASE=http://localhost:11434

# MinerU configuration
# MINERU_MODEL_SOURCE=modelscope   # Use "modelscope" for China mirror
# MINERU_API_KEY=                   # Set to use cloud API (mineru.net) instead of local

# LLM rate limiting (adjust based on your API provider's RPM limit)
# THEIA_LLM_MAX_CONCURRENT=3    # max parallel requests (default: 3)
# THEIA_LLM_MIN_INTERVAL=0.5    # min seconds between requests (default: 0.5)

# Theia defaults
THEIA_LLM_MODEL=gpt-4o
THEIA_LANGUAGE=zh
THEIA_FPS=30
THEIA_MINERU_BACKEND=pipeline
THEIA_TTS_VOICE=zh-CN-YunxiNeural
# THEIA_TTS_MAX_RETRIES=3        # TTS retry attempts on network failure (default: 3)
# THEIA_TTS_TIMEOUT=30            # TTS timeout per attempt in seconds (default: 30)

# Per-step model override (cost optimization)
# Extraction needs accuracy -> use powerful model
THEIA_EXTRACT_MODEL=gpt-4o
# Script narration is lighter -> use cheaper/faster model
THEIA_SCRIPT_MODEL=gpt-4o-mini
# Figure analysis requires a vision-capable model (e.g. gpt-4o, claude-3)
# Do NOT use text-only models like moonshot, deepseek-chat, etc.
THEIA_FIGURE_MODEL=gpt-4o
