# =============================================================================
# Theia LLM 配置
# =============================================================================
# 所有步骤默认使用 Kimi (Moonshot AI) 模型。
# 通用 API 凭据作为所有步骤的默认后备值。

# --- 通用 API 凭据（所有步骤的默认后备） ---
THEIA_API_KEY=your-kimi-api-key
THEIA_API_BASE=https://api.moonshot.cn/v1

# --- MinerU 配置 ---
# MINERU_MODEL_SOURCE=modelscope   # Use "modelscope" for China mirror
# MINERU_API_KEY=                   # Set to use cloud API (mineru.net) instead of local

# --- LLM 速率限制 ---
# THEIA_LLM_MAX_CONCURRENT=3    # 最大并发请求数 (默认: 3)
# THEIA_LLM_MIN_INTERVAL=0.5    # 请求最小间隔秒数 (默认: 0.5)

# =============================================================================
# 各步骤模型配置（每个步骤可独立设置 MODEL / API_KEY / API_BASE）
# 未设置时回退到通用 API 凭据 (THEIA_API_KEY / THEIA_API_BASE)
# =============================================================================

# --- Pass 1: 快速扫描 ---
THEIA_SCAN_MODEL=kimi-k2-0905-preview
# THEIA_SCAN_API_KEY=             # 默认使用 THEIA_API_KEY
# THEIA_SCAN_API_BASE=            # 默认使用 THEIA_API_BASE

# --- Pass 2: 深度提取 ---
THEIA_EXTRACT_MODEL=kimi-k2-0905-preview
# THEIA_EXTRACT_API_KEY=          # 默认使用 THEIA_API_KEY
# THEIA_EXTRACT_API_BASE=         # 默认使用 THEIA_API_BASE

# --- Pass 3: 图表分析（需要多模态/视觉模型） ---
THEIA_FIGURE_MODEL=kimi-k2.5
# THEIA_FIGURE_API_KEY=           # 默认使用 THEIA_API_KEY
# THEIA_FIGURE_API_BASE=          # 默认使用 THEIA_API_BASE

# --- 故事架构师 ---
THEIA_STORY_MODEL=kimi-k2-0905-preview
# THEIA_STORY_API_KEY=            # 默认使用 THEIA_API_KEY
# THEIA_STORY_API_BASE=           # 默认使用 THEIA_API_BASE

# --- 场景编剧 ---
THEIA_SCENE_MODEL=kimi-k2-0905-preview
# THEIA_SCENE_API_KEY=            # 默认使用 THEIA_API_KEY
# THEIA_SCENE_API_BASE=           # 默认使用 THEIA_API_BASE

# --- 质量门控修复 ---
THEIA_GATE_MODEL=kimi-k2-0905-preview
# THEIA_GATE_API_KEY=             # 默认使用 THEIA_API_KEY
# THEIA_GATE_API_BASE=            # 默认使用 THEIA_API_BASE

# --- L3 深度评估 ---
THEIA_JUDGE_MODEL=kimi-k2-0905-preview
# THEIA_JUDGE_API_KEY=            # 默认使用 THEIA_API_KEY
# THEIA_JUDGE_API_BASE=           # 默认使用 THEIA_API_BASE

# --- 脚本生成（story + scene 的通用后备，向后兼容） ---
# THEIA_SCRIPT_MODEL=kimi-k2-0905-preview
# THEIA_SCRIPT_API_KEY=
# THEIA_SCRIPT_API_BASE=

# =============================================================================
# 其他配置
# =============================================================================
THEIA_LANGUAGE=zh
THEIA_FPS=30
THEIA_MINERU_BACKEND=pipeline
THEIA_TTS_VOICE=zh-CN-YunxiNeural
# THEIA_TTS_MAX_RETRIES=3        # TTS retry attempts on network failure (default: 3)
# THEIA_TTS_TIMEOUT=30            # TTS timeout per attempt in seconds (default: 30)
# THEIA_NARRATION_STYLE=default   # default | academic | story | popsci
# THEIA_THEME=academic            # academic | popsci

# =============================================================================
# 其他 LLM 提供商（可选，用于备用 API 降级）
# =============================================================================
# OPENAI_API_KEY=sk-...
# OPENAI_API_BASE=https://api.openai.com/v1
# ANTHROPIC_API_KEY=sk-ant-...
# DEEPSEEK_API_KEY=...
# SILICONFLOW_API_KEY=...
# SILICONFLOW_API_BASE=https://api.siliconflow.cn/v1
