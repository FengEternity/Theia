# LLM provider configuration (used by LiteLLM)
# Uncomment the provider you want to use:

# OpenAI
# OPENAI_API_KEY=sk-...

# Anthropic
# ANTHROPIC_API_KEY=sk-ant-...

# DeepSeek
# DEEPSEEK_API_KEY=...

# Local (Ollama)
# OLLAMA_API_BASE=http://localhost:11434

# MinerU configuration
# MINERU_MODEL_SOURCE=modelscope   # Use "modelscope" for China mirror
# MINERU_API_KEY=                   # Set to use cloud API (mineru.net) instead of local

# Theia defaults
THEIA_LLM_MODEL=gpt-4o
THEIA_LANGUAGE=zh
THEIA_FPS=30
THEIA_MINERU_BACKEND=pipeline
THEIA_TTS_VOICE=zh-CN-YunxiNeural

# Per-step model override (cost optimization)
# Extraction needs accuracy -> use powerful model
THEIA_EXTRACT_MODEL=gpt-4o
# Script narration is lighter -> use cheaper/faster model
THEIA_SCRIPT_MODEL=gpt-4o-mini
